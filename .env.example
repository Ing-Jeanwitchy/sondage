# ============================================================
# Paramètres d'Environnement - Sondage Électoral Nord-Ouest
# ============================================================

# Mode Debug (Mettre 'False' en production sur Render)
DEBUG=True

# Clé secrète Django
SECRET_KEY=django-insecure-nord-ouest-haiti-sondage-preliminaire-secret-2026

# Hôtes autorisés (séparés par virgules)
ALLOWED_HOSTS=*

# Base de données PostgreSQL (Render définit DATABASE_URL automatiquement)
# En local, laisser vide pour utiliser SQLite automatiquement
DATABASE_URL=

# Configuration Cloudinary (Médias & Photos dans le Cloud)
# Obtenez vos clés gratuites sur https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origines CORS supplémentaires (optionnel)
CORS_ALLOWED_ORIGINS=https://sondage-nord-ouest.web.app,https://sondage-nord-ouest.firebaseapp.com
